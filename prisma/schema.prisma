generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

model User {
  id         String   @id @default(cuid())
  name       String?
  email      String   @unique
  password   String

  avatarUrl  String?
  bannerUrl  String?

  resetToken       String?
  resetTokenExpiry DateTime?

  tasks      Task[]

  createdAt DateTime @default(now())

  @@index([resetTokenExpiry])
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  completed   Boolean    @default(false)
  status      TaskStatus @default(PENDING)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?
  tag         String?    @default("Personal")

  // Orden de la tarjeta dentro de una columna del tablero.
  // Un número menor aparece antes que uno mayor.
  position    Int        @default(0)

  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Optimiza la consulta de tareas por usuario, columna y posición.
  @@index([userId, status, position])
}